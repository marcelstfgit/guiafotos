<Application x:Class="GuiaFotos.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Application.Resources>
<SolidColorBrush x:Key="Accent" Color="#497D9F"/>
<Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#3D454D"/></Style>
<Style TargetType="Button"><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="3"/><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FEFEFE" Offset="0"/><GradientStop Color="#E6E9EC" Offset="1"/></LinearGradientBrush></Setter.Value></Setter><Setter Property="Foreground" Value="#3D454D"/><Setter Property="BorderBrush" Value="#BCC3C9"/><Setter Property="Cursor" Value="Hand"/></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="3"/><Setter Property="BorderBrush" Value="#BDC4CB"/></Style>
<Style TargetType="ComboBox"><Setter Property="Padding" Value="5"/><Setter Property="Margin" Value="3"/></Style>
<Style TargetType="TabItem"><Setter Property="Padding" Value="11,7"/></Style>
<Style TargetType="GroupBox"><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="8"/></Style>
</Application.Resources></Application>
