<Application x:Class="GuiaFotos.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Application.Resources>
<SolidColorBrush x:Key="Accent" Color="#087F8C"/>
<Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="#EDF5F5"/><Setter Property="Foreground" Value="#153A3F"/><Setter Property="BorderBrush" Value="#CEE1E2"/><Setter Property="Cursor" Value="Hand"/></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="3"/><Setter Property="BorderBrush" Value="#CCDADA"/></Style>
<Style TargetType="ComboBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="3"/></Style>
<Style TargetType="TabItem"><Setter Property="Padding" Value="16,10"/></Style>
<Style TargetType="GroupBox"><Setter Property="Margin" Value="8"/><Setter Property="Padding" Value="8"/></Style>
</Application.Resources></Application>
