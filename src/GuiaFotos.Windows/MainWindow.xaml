<Window x:Class="GuiaFotos.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GuiaFotos.Windows" Title="GuiaFotos" Width="1380" Height="860" MinWidth="1000" MinHeight="640" Background="#F2F2F2" AllowDrop="True" Drop="Dropped" Closing="ClosingApp" PreviewKeyDown="WindowKeyboard">
 <Window.Resources>
  <Style x:Key="Navigation" TargetType="Button"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#59616A"/><Setter Property="Margin" Value="13,16,8,6"/></Style>
  <Style x:Key="ActionButton" TargetType="Button"><Setter Property="Padding" Value="15,7"/><Setter Property="Margin" Value="3,0"/><Setter Property="MinWidth" Value="76"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F6F9FB"/><Setter TargetName="Surface" Property="BorderBrush" Value="#B4C0CA"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#6F9FBE"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D1E3EF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <DataTemplate x:Key="LocationTemplate"><Grid Margin="8,5"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="#B49657" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/><TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="#858B92" Margin="8,0,2,0"/></Grid></DataTemplate>
  <Style x:Key="LocationItem" TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,1"/></Style>
 </Window.Resources>
 <Grid Background="#F2F2F2">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="24"/></Grid.RowDefinitions>
  <Menu Background="#F7F7F7" BorderBrush="#D2D4D6" BorderThickness="0,0,0,1" Padding="4,2">
   <MenuItem Header="_Arquivo"><MenuItem Header="Adicionar pasta…" InputGestureText="Ctrl+O" Click="AddFolder"/><MenuItem Header="Exportar seleção…" InputGestureText="Ctrl+E" Click="ExportSelected"/><MenuItem Header="Imprimir foto…" Click="PrintSelected"/><Separator/><MenuItem Header="Sair" Click="ExitApplication"/></MenuItem>
   <MenuItem Header="_Editar"><MenuItem Header="Editar foto" InputGestureText="Enter" Click="EditSelected"/><MenuItem Header="Girar à direita" Click="Rotate"/><MenuItem Header="Marcar como favorita" Click="ToggleFavorite"/><Separator/><MenuItem Header="Metadados…" Click="EditMetadata"/><MenuItem Header="Remover EXIF em cópias…" Click="StripExif"/><MenuItem Header="Remover dados pessoais em cópias…" Click="StripPrivate"/><Separator/><MenuItem Header="Mover seleção para lixeira…" InputGestureText="Del" Click="TrashSelected"/></MenuItem>
   <MenuItem Header="E_xibir"><MenuItem Header="Biblioteca" Click="ShowAll"/><MenuItem Header="Pessoas" Click="ShowPeople"/><MenuItem Header="Fotos semelhantes" Click="ShowVersions"/><Separator/><MenuItem Header="Mostrar nomes dos arquivos" x:Name="ShowFileNames" IsCheckable="True" IsChecked="True" Click="ToggleFileNames"/><MenuItem Header="Miniaturas maiores" Click="LargerThumbnails"/><MenuItem Header="Miniaturas menores" Click="SmallerThumbnails"/></MenuItem>
   <MenuItem Header="_Pasta"><MenuItem Header="Atualizar pasta" InputGestureText="F5" Click="RefreshFolder"/><MenuItem Header="Renomear seleção por data…" Click="RenameByDate"/><MenuItem Header="Mostrar foto no Explorer" Click="RevealOriginal"/></MenuItem>
   <MenuItem Header="_Ferramentas"><MenuItem Header="Encontrar duplicatas" Click="ShowDuplicates"/><MenuItem Header="Backup Nextcloud" Click="ShowCloud"/><MenuItem Header="Histórico e recuperação" Click="ShowHistory"/><MenuItem Header="Assistente de organização" Click="ShowAssistant"/><Separator/><MenuItem Header="Configurações" Click="ShowSettings"/></MenuItem>
   <MenuItem Header="A_juda"><MenuItem Header="Sobre o GuiaFotos" Click="ShowAbout"/></MenuItem>
  </Menu>
  <Border x:Name="LibraryToolbar" Grid.Row="1" BorderBrush="#C9CDD1" BorderThickness="0,0,0,1" Background="#ECEEF0" Padding="10,6"><Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button Click="AddFolder" Padding="11,5"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Adicionar pasta"/></StackPanel></Button>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center"><TextBlock Text="Filtros:" Foreground="#707780" VerticalAlignment="Center" Margin="0,0,7,0"/><Button x:Name="FavoriteFilter" Click="ShowFavorites" ToolTip="Favoritas" Content="☆" FontSize="18" Padding="8,1"/><Button x:Name="PhotoFilter" Click="ShowPhotos" Content="Fotos" Padding="9,4"/><Button x:Name="VideoFilter" Click="ShowVideos" Content="Vídeos" Padding="9,4"/><Button Click="ClearFilters" ToolTip="Limpar filtros" Content="×" Padding="8,3"/></StackPanel>
   <Border Grid.Column="3" Background="White" BorderBrush="#B8BEC5" BorderThickness="1" CornerRadius="3" Padding="7,1"><DockPanel><TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#71818D" VerticalAlignment="Center" Margin="0,0,6,0"/><Button DockPanel.Dock="Right" Content="×" Click="ClearSearch" Padding="3,0" Background="Transparent" BorderThickness="0"/><Grid><TextBox x:Name="Search" BorderThickness="0" Background="Transparent" Padding="2,4" Margin="0" TextChanged="SearchChanged" ToolTip="Pesquisar nas fotos exibidas"/><TextBlock Text="Pesquisar fotos…" Foreground="#969CA2" IsHitTestVisible="False" Margin="3,4"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel></Border>
   <Button Grid.Column="4" Click="ShowSettings" FontFamily="Segoe MDL2 Assets" Content="&#xE713;" Padding="9,4" Margin="9,0,0,0" ToolTip="Configurações"/>
  </Grid></Border>
  <Grid Grid.Row="2" x:Name="WorkspacePanel">
   <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="LibrarySidebar" Grid.Column="0" BorderBrush="#C4C9CE" BorderThickness="0,0,1,0" Background="#ECEEF0"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,8,0,0"><Button x:Name="LibraryNavigation" Style="{StaticResource Navigation}" Click="ShowAll"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/><TextBlock Text="Biblioteca" FontWeight="SemiBold"/></StackPanel></Button><Button Style="{StaticResource Navigation}" Click="ShowPeople"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/><TextBlock Text="Pessoas"/></StackPanel></Button><Button Style="{StaticResource Navigation}" Click="ShowVersions"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B6;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/><TextBlock Text="Fotos semelhantes"/></StackPanel></Button></StackPanel>
    <DockPanel Grid.Row="1"><Button Content="+" Click="CreateAlbum" DockPanel.Dock="Right" Padding="7,0" Margin="4,12,8,0" ToolTip="Criar álbum com a seleção"/><TextBlock Text="ÁLBUNS" Style="{StaticResource SectionTitle}"/></DockPanel>
    <ListBox x:Name="Albums" Grid.Row="2" MaxHeight="150" SelectionChanged="AlbumSelected" ItemTemplate="{StaticResource LocationTemplate}" ItemContainerStyle="{StaticResource LocationItem}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    <TextBlock Grid.Row="3" Text="PASTAS" Style="{StaticResource SectionTitle}"/>
    <ListBox x:Name="Folders" Grid.Row="4" SelectionChanged="FolderSelected" ItemTemplate="{StaticResource LocationTemplate}" ItemContainerStyle="{StaticResource LocationItem}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    <Button Grid.Row="5" Style="{StaticResource Navigation}" Click="ShowCloud" BorderBrush="#D2D5D8" BorderThickness="0,1,0,0" Foreground="#657480"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/><TextBlock Text="Backup Nextcloud"/></StackPanel></Button>
   </Grid></Border>
   <TabControl x:Name="Tabs" Grid.Column="1" SelectedIndex="0" BorderThickness="0" Background="#F5F5F5" SelectionChanged="PageChanged">
    <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
    <TabItem Header="Biblioteca"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="#FAFAFA" BorderBrush="#DDDFE1" BorderThickness="0,0,0,1" Padding="18,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="LibraryTitle" Text="Todas as pastas" FontSize="21" FontWeight="SemiBold" Foreground="#414A53"/><TextBlock x:Name="LibrarySubtitle" Text="Sua coleção de fotos, organizada no computador" Foreground="#737B83" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Content="Atualizar" Click="RefreshFolder" VerticalAlignment="Center" Padding="10,5"/></Grid></Border>
     <local:PhotoGrid x:Name="Gallery" Grid.Row="1" SelectionChanged="SelectedPhoto"/>
     <StackPanel x:Name="EmptyLibrary" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"><TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="58" Foreground="#A5ADB4" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="Sua biblioteca de fotos" FontSize="25" FontWeight="Light" HorizontalAlignment="Center" Margin="0,20,0,8"/><TextBlock x:Name="EmptyHint" Text="Adicione uma pasta para começar a reencontrar suas fotos." Foreground="#737B83" TextAlignment="Center"/><Button Content="Adicionar pasta…" Click="AddFolder" HorizontalAlignment="Center" Margin="0,22,0,0" Padding="20,8"/></StackPanel>
    </Grid></TabItem>
    <TabItem Header="Duplicatas"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><WrapPanel><Button Content="Candidatos rápidos" Click="FindCandidates"/><Button Content="Confirmar idênticos" Click="FindExact"/><Button Content="Encontrar idênticos e semelhantes" Click="FindDuplicates"/></WrapPanel><TextBlock Text="Candidatos: tamanho + primeiros e últimos 16 KB (xxHash64). Confirmar idênticos compara os bytes completos só dos candidatos. Use Versões de fotos para agrupar cópias com brilho, qualidade ou resolução diferentes. Revise antes de mover." TextWrapping="Wrap" Margin="4,8"/></StackPanel><ListBox x:Name="DuplicateList" SelectionChanged="DuplicateSelected"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Type}" FontWeight="Bold"/><TextBlock Text="{Binding Confidence, StringFormat=Índice de semelhança: {0:P0}}"/><ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Path}" Margin="4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></TabItem>
<TabItem Header="Nextcloud"><DockPanel Margin="16"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Backup verificável e recuperação" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Configure seu servidor na aba Configurações. Cada backup cria uma pasta independente e um manifest com SHA-256; arquivos existentes não são sobrescritos." TextWrapping="Wrap" Margin="0,10"/><WrapPanel><Button Content="Listar backups" Click="ListBackups"/><Button Content="Backup de toda a biblioteca" Click="BackupAll"/><Button Content="Restaurar backup selecionado…" Click="RestoreBackup"/><Button Content="Upload de arquivo…" Click="UploadFile"/><Button Content="Download de arquivo…" Click="DownloadFile"/></WrapPanel><WrapPanel><Button Content="Listar lixeira Nextcloud" Click="ListCloudTrash"/><Button Content="Restaurar item da lixeira" Click="RestoreCloudTrash"/></WrapPanel></StackPanel><ListBox x:Name="CloudList" DisplayMemberPath="Name" Margin="0,10"/></DockPanel></TabItem>
<TabItem Header="Recuperação e histórico"><DockPanel Margin="16"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Recuperar arquivos e desfazer renomeações" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="A lixeira do GuiaFotos guarda uma cópia verificada antes de remover o arquivo da pasta. Recuperação física de setores apagados não é garantida, especialmente em SSD com TRIM." TextWrapping="Wrap" Margin="0,10"/><WrapPanel><Button Content="Atualizar histórico" Click="RefreshHistory"/><Button Content="Restaurar / desfazer selecionado…" Click="RestoreHistory"/><Button Content="Abrir lixeira do Windows" Click="OpenRecycleBin"/></WrapPanel></StackPanel><DataGrid x:Name="History" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" Margin="0,10"><DataGrid.Columns><DataGridTextColumn Header="Quando" Binding="{Binding Time}"/><DataGridTextColumn Header="Estado" Binding="{Binding State}"/><DataGridTextColumn Header="Operação" Binding="{Binding Type}"/><DataGridTextColumn Header="Original" Binding="{Binding Source}" Width="*"/><DataGridTextColumn Header="Resultado" Binding="{Binding Destination}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
<TabItem Header="Assistente IA"><DockPanel Margin="16"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Dê instruções à sua biblioteca" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Selecione até 100 itens na Biblioteca. O assistente recebe nomes, datas, tipo, etiquetas e sua instrução; imagens e arquivos não são enviados. A API pode cobrar pelo uso. Você revisa o plano antes de executar." TextWrapping="Wrap" Margin="0,10"/><TextBox x:Name="Instruction" Height="85" TextWrapping="Wrap" AcceptsReturn="True" ToolTip="Ex.: melhore estas fotos, remova EXIF nas cópias e faça backup no Nextcloud"/><WrapPanel><Button Content="Gerar plano com IA…" Click="GeneratePlan"/><Button x:Name="ExecutePlanButton" Content="Revisar e executar plano…" Click="ExecutePlan" IsEnabled="False"/></WrapPanel></StackPanel><TextBox x:Name="PlanView" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,10"/></DockPanel></TabItem>
<TabItem Header="Configurações"><ScrollViewer><StackPanel Width="650" HorizontalAlignment="Left" Margin="16"><TextBlock Text="Nextcloud" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Servidor HTTPS (inclua o subdiretório se houver)"/><TextBox x:Name="CloudUrl"/><TextBlock Text="Usuário"/><TextBox x:Name="CloudUser"/><TextBlock Text="Senha de aplicativo (fica protegida pelo DPAPI do Windows)"/><PasswordBox x:Name="CloudPassword" Padding="8" Margin="3"/><TextBlock Text="Pasta remota de backups"/><TextBox x:Name="CloudFolder"/><Button Content="Testar conexão Nextcloud" Click="CheckCloud"/>
   <Separator Margin="0,15"/><TextBlock Text="Assistente opcional" FontSize="22" FontWeight="SemiBold"/><ComboBox x:Name="Provider"><ComboBoxItem Content="OpenAI"/><ComboBoxItem Content="Claude"/><ComboBoxItem Content="ChatGPT"/></ComboBox><TextBlock Text="Chave de API do provedor escolhido (protegida pelo DPAPI)"/><PasswordBox x:Name="AiKey" Padding="8" Margin="3"/><TextBlock Text="Modelo"/><ComboBox x:Name="Model" IsEditable="True"/><WrapPanel><Button Content="Consultar modelos da conta" Click="LoadModels"/><Button Content="Continue with ChatGPT" Click="ChatGptLogin"/><Button Content="Sair do ChatGPT" Click="ChatGptLogout"/></WrapPanel><TextBlock Text="O login ChatGPT usa o navegador com OAuth/PKCE oficial para aplicativos abertos. Login por device code não é simulado; Claude usa chave de API." TextWrapping="Wrap" Margin="4" Foreground="#637879"/>
   <Separator Margin="0,15"/><TextBlock Text="Pasta padrão para exportar cópias"/><TextBox x:Name="ExportFolder"/><Button Content="Salvar configurações" Click="SaveSettings"/><Button Content="Verificar ferramentas instaladas" Click="CheckTools"/>
  </StackPanel></ScrollViewer></TabItem>
   </TabControl>
   <Grid x:Name="EditorScreen" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#E4E6E8">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="78"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="262"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.ColumnSpan="2" Background="#F3F4F5" BorderBrush="#C1C5C9" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="262"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="‹  Voltar à biblioteca" Click="BackToLibrary" Padding="12,6" Margin="10,6" HorizontalAlignment="Left"/><TextBlock x:Name="SelectedName" Grid.Column="1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8"><Button Content="‹" Click="PreviousPhoto" ToolTip="Foto anterior (←)" Padding="12,3"/><TextBlock x:Name="EditorPosition" VerticalAlignment="Center" Margin="12,0"/><Button Content="›" Click="NextPhoto" ToolTip="Próxima foto (→)" Padding="12,3"/></StackPanel></Grid></Border>
    <Border Grid.Row="1" BorderBrush="#BFC4CA" BorderThickness="0,0,1,0" Background="#F0F1F2"><DockPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="12"><UniformGrid Columns="2" Margin="0,0,0,5"><Button x:Name="UndoButton" Content="Desfazer" Click="UndoPreview" IsEnabled="False"/><Button x:Name="RedoButton" Content="Refazer" Click="RedoPreview" IsEnabled="False"/></UniformGrid><Separator/><Button x:Name="ExportButton" Content="Salvar cópia editada…" Click="ExportPreview" IsEnabled="False" Padding="10,9"/><TextBlock Text="As alterações são feitas em cópias." FontSize="11" Foreground="#7B8289" HorizontalAlignment="Center" Margin="0,7"/></StackPanel>
     <TabControl Margin="8,12,8,0" Background="Transparent" BorderThickness="0"><TabItem Header="Básico"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="6,6,6,0">
      <UniformGrid Columns="2"><Button Click="Crop" Padding="5,6" Margin="3"><StackPanel><TextBlock Text="&#xE7A8;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="Recortar" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button><Button Click="Rotate" Padding="5,6" Margin="3"><StackPanel><TextBlock Text="&#xE7AD;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="Girar" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button></UniformGrid>
      <Button Content="Estou com sorte" Click="Lucky" Padding="8,5" Margin="3,6,3,3"/><Button Content="Restaurar foto" Click="RestoreOld" Padding="8,5" Margin="1"/>
      <TextBlock Text="Ajustes de luz e cor" Foreground="#737B83" Margin="4,8,4,4"/><TextBlock Text="Brilho" Margin="4,2"/><Slider x:Name="Brightness" Minimum="-70" Maximum="70" Value="0" Margin="1"/><TextBlock Text="Contraste" Margin="4,4,4,2"/><Slider x:Name="Contrast" Minimum="-70" Maximum="70" Value="0" Margin="1"/><TextBlock Text="Saturação" Margin="4,4,4,2"/><Slider x:Name="Saturation" Minimum="0" Maximum="200" Value="100" Margin="1"/>
      <Button x:Name="ApplyAdjustmentsButton" Content="Aplicar ajustes" Click="ApplyAdjustments" Margin="3,6,3,3"/>
     </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Organizar"><StackPanel Margin="8,16,8,0"><TextBlock Text="Avaliação"/><ComboBox x:Name="Rating" Margin="0,6,0,14"><ComboBoxItem Content="Sem avaliação"/><ComboBoxItem Content="1 ★"/><ComboBoxItem Content="2 ★"/><ComboBoxItem Content="3 ★"/><ComboBoxItem Content="4 ★"/><ComboBoxItem Content="5 ★"/></ComboBox><TextBlock Text="Etiquetas"/><TextBox x:Name="TagsBox" Margin="0,6,0,14"/><TextBlock Text="Álbum"/><TextBox x:Name="AlbumBox" Margin="0,6,0,14"/><Button Content="Salvar organização" Click="SaveOrganize"/><Separator Margin="0,16"/><Button Content="Todos os metadados…" Click="EditMetadata"/><Button Content="Mostrar no Explorer" Click="RevealOriginal"/><Button Content="Abrir em outro aplicativo" Click="OpenOriginal"/></StackPanel></TabItem>
     </TabControl>
    </DockPanel></Border>
    <Grid Grid.Row="1" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border x:Name="CropActions" Visibility="Collapsed" Background="#E8EEF3" Padding="12,7"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ApplyCropButton" Content="Aplicar recorte" Click="ApplyCrop" IsEnabled="False"/><Button Content="Cancelar" Click="CancelCrop"/></StackPanel><TextBlock Text="Arraste sobre a foto para escolher o recorte." VerticalAlignment="Center"/></DockPanel></Border><local:PhotoCanvas x:Name="Preview" Grid.Row="1" Focusable="True"/></Grid>
    <ListBox x:Name="Filmstrip" Grid.Row="2" Grid.ColumnSpan="2" SelectionChanged="FilmstripSelected" Background="#D1D5D9" BorderBrush="#AEB5BC" BorderThickness="0,1,0,0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="2"/><Setter Property="Margin" Value="2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Frame" BorderThickness="2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#4987B1"/><Setter TargetName="Frame" Property="Background" Value="#F7FBFE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Image Source="{Binding Thumbnail}" Width="73" Height="51" Stretch="Uniform" Margin="3" ToolTip="{Binding Name}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
   </Grid>
  </Grid>
  <Border x:Name="SelectionBar" Grid.Row="3" Background="#E6E9EC" BorderBrush="#BAC2C9" BorderThickness="0,1,0,0" Padding="10,9"><Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="185"/></Grid.ColumnDefinitions>
   <DockPanel><Border Background="White" Padding="3" BorderBrush="#B8C0C7" BorderThickness="1" Width="80" Height="60"><Grid><Image x:Name="SelectionPreview" Stretch="Uniform"/><ItemsControl x:Name="SelectionThumbnails" Visibility="Collapsed"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" Rows="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="1"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border><StackPanel VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock x:Name="SelectionCount" Text="Nenhuma foto" FontWeight="SemiBold"/><Button Content="Limpar seleção" Click="ClearSelection" FontSize="11" Padding="0,3" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Foreground="#627A8E" Margin="0,4,0,0"/></StackPanel></DockPanel>
