    <Button x:Name="RotateAction" Style="{StaticResource ActionButton}" Click="Rotate"><StackPanel><TextBlock Foreground="#6383A2" Text="&#xE7AD;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="Girar" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
    <Button x:Name="ExportAction" Style="{StaticResource ActionButton}" Click="ExportSelected"><StackPanel><TextBlock Foreground="#6B875F" Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="Exportar" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
    <Button Style="{StaticResource ActionButton}" Click="ShowPeople"><StackPanel><TextBlock Foreground="#8A7299" Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="Pessoas" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
   </StackPanel>
   <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="Tamanho das miniaturas" Foreground="#6D7781" FontSize="11" Margin="2,0,0,8"/><DockPanel><TextBlock Text="−" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="+" DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center"/><Slider x:Name="ThumbnailZoom" Minimum="96" Maximum="280" Value="164" ValueChanged="ThumbnailZoomChanged" SmallChange="12" LargeChange="24" VerticalAlignment="Center"/></DockPanel></StackPanel>
  </Grid></Border>
  <Border Grid.Row="4" Background="#6388A0" Padding="10,2"><DockPanel><Button x:Name="CancelTaskButton" Visibility="Collapsed" DockPanel.Dock="Right" Content="Cancelar tarefa" Click="CancelTask" FontSize="10" Foreground="White" Background="Transparent" BorderThickness="0" Padding="3,0" Margin="0"/><ProgressBar x:Name="Progress" Width="100" Height="7" DockPanel.Dock="Right" Margin="10,0" Visibility="Collapsed" IsIndeterminate="True"/><TextBlock x:Name="Count" DockPanel.Dock="Right" Foreground="White" Margin="18,0,10,0" VerticalAlignment="Center" FontSize="11"/><TextBlock x:Name="Status" Foreground="White" VerticalAlignment="Center" FontSize="11" Text="Adicione uma pasta ou arraste suas fotos para a biblioteca." TextTrimming="CharacterEllipsis"/></DockPanel></Border>
 </Grid>
</Window>
